# Django
SECRET_KEY=generate-a-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL)
DB_NAME=estate360
DB_USER=postgres
DB_PASSWORD=change-this-to-a-strong-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://postgres:change-this-to-a-strong-password@db:5432/estate360

# Redis (caching + channels + sessions)
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend URL (for links in emails etc.)
FRONTEND_URL=http://localhost:3000

# Throttling
THROTTLE_ANON_RATE=100/day
THROTTLE_USER_RATE=1000/day

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@estate360.com
